{% comment %} Announcement Bar {% endcomment %}

<div class="announcement-bar" style="background:{{ section.settings.bg_color }}">
  <p class="announcement-bar__main">
    <span class="announcement-bar__dot"></span>
    {{ section.settings.main_text }}
    <span class="announcement-bar__dot"></span>
  </p>
  <p class="announcement-bar__sub">
    {{ section.settings.sub_text }}
  </p>
</div>

<style>
  .announcement-bar {
    text-align: center;
    padding: 13px 20px;
    width: 100%;
    box-sizing: border-box;
  }

  .announcement-bar__main {
    font-family: 'Poppins', sans-serif;
    font-weight: 300;
    font-size: 15px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
    margin: 0;
    line-height: 1.3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .announcement-bar__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: {{ section.settings.text_color }};
    opacity: 0.5;
    display: inline-block;
    flex-shrink: 0;
  }

  .announcement-bar__sub {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: {{ section.settings.text_color }};
    margin: 4px 0 0;
    opacity: 0.82;
  }
</style>

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour",
      "default": "#5C3D2A"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour",
      "default": "#F2EEE8"
    },
    {
      "type": "text",
      "id": "main_text",
      "label": "Main line (sale name)",
      "default": "Summer Vitality Sale — Now Live"
    },
    {
      "type": "text",
      "id": "sub_text",
      "label": "Sub line (discount detail)",
      "default": "Use code SUMMER30 · 30% off all bundles"
    }
  ],
  "presets": [{ "name": "Announcement Bar" }]
}
{% endschema %}
